rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private LUX / NOX cloud data: each Google account sees only its own records.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isCompanion(name) {
      return name in ['lux', 'nox'];
    }
    match /users/{uid}/companions/{companion} {
      allow read, write: if isOwner(uid) && isCompanion(companion);
      match /chats/{chatId} {
        allow read, write: if isOwner(uid) && isCompanion(companion);
      }
      match /photos/{photoId} {
        allow read, write: if isOwner(uid) && isCompanion(companion);
        match /parts/{partId} {
          allow read, write: if isOwner(uid) && isCompanion(companion);
        }
      }
    }
    // All other paths remain inaccessible unless separately permitted.
  }
}
