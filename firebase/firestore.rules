rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function companion(agent) {
      return agent in ['lux', 'nox'];
    }
    match /users/{uid}/agents/{agent} {
      allow read, write: if owner(uid) && companion(agent);
      match /chats/{chatId} {
        allow read, write: if owner(uid) && companion(agent);
      }
      match /media/{photoId} {
        allow read, write: if owner(uid) && companion(agent);
        match /parts/{partId} {
          allow read, write: if owner(uid) && companion(agent);
        }
      }
    }
  }
}
